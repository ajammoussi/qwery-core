{
  "extends": "@qwery/tsconfig/base.json",
  "compilerOptions": {
    "skipLibCheck": true,
    "tsBuildInfoFile": "node_modules/.cache/tsbuildinfo.json",
    "baseUrl": ".",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "module": "ESNext",
    "moduleResolution": "bundler"
  },
  "include": ["*.ts", "src"],
  "exclude": ["node_modules", "dist", "src/shims"],
  "ts-node": {
    "esm": true,
    "swc": true
  }
}
