        "correctionType": "explicit",
        "expectedBehavior": "Agent should use L_QUANTITY column"
      }
    },
    {
      "turnNumber": 4,
      "role": "user",
      "content": "Exclude orders with order priority '4-NOT SPECIFIED'.",
