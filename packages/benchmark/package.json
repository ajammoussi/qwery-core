{
  "name": "@qwery/benchmark",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "run": "node --experimental-specifier-resolution=node --loader ts-node/esm src/run-all.ts",
    "run:tpch": "node --experimental-specifier-resolution=node --loader ts-node/esm src/run-all.ts --db tpch",
    "run:saas": "node --experimental-specifier-resolution=node --loader ts-node/esm src/run-all.ts --db saas",
    "run:baseline": "node --experimental-specifier-resolution=node --loader ts-node/esm src/run-all.ts --compression-method baseline-no-compression",
    "run:compression": "node --experimental-specifier-resolution=node --loader ts-node/esm src/run-all.ts --compression-method",
    "extract": "node --experimental-specifier-resolution=node --loader ts-node/esm src/extract-results.ts",
    "extract:baseline": "node --experimental-specifier-resolution=node --loader ts-node/esm src/extract-results.ts baseline-no-compression",
    "validate": "node --experimental-specifier-resolution=node --loader ts-node/esm src/validate-session.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@qwery/agent-factory-sdk": "workspace:*",
    "@qwery/domain": "workspace:*",
    "@qwery/repository-file": "workspace:*",
    "@qwery/shared": "workspace:*",
    "uuid": "^11.0.3"
  },
  "peerDependencies": {
    "ai": "^6.0.0"
  },
  "devDependencies": {
    "@qwery/tsconfig": "workspace:*",
    "@swc/core": "^1.11.0",
    "@types/node": "^20.19.0",
    "ai": "^6.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.0"
  },
  "ts-node": {
    "swc": true,
    "esm": true
  }
}
