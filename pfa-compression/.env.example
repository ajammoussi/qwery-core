# TPC-H PostgreSQL Configuration
# Copy this to .env and customize as needed

# Scale factor for TPC-H data generation
# 1 = ~1GB, 10 = ~10GB, 100 = ~100GB, etc.
SCALE_FACTOR=1

# PostgreSQL Database Credentials
DB_USER=postgres
DB_PASSWORD=postgres
# Use a non-default host port to avoid collisions with local PostgreSQL installs.
DB_PORT=55432

# Data directory (optional, defaults to /tmp/tpch_data inside container)
# DATA_DIR=/mnt/data/tpch

# PostgreSQL Advanced Settings (optional)
# POSTGRES_INITDB_ARGS=-c max_connections=200
